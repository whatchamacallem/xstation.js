# A dash under a pty, the one process the server forks. Debug mode only.
class Console:
    # Forks dash with a scrubbed environment, `cwd` as its directory and
    # `TERM` as given. Sets `pid` and `fd`, the pty's master, for select.
    def __init__(self, cwd: str, term: str, columns: int, rows: int) -> None: ...
    pid: int
    fd: int
    # Writes bytes to the pty, all of them.
    def console_write(self, data: bytes) -> None: ...
    # Reads what the pty has, up to `size` bytes; empty at its end.
    def console_read(self, size: int) -> bytes: ...
    # Sends the signal to dash's process group.
    def console_signal(self, signal_number: int) -> None: ...
    # Returns dash's exit code once it has exited, or None while it runs.
    def console_poll(self) -> int | None: ...
    # Closes the pty and kills the group; returns the exit code.
    def console_close(self) -> int: ...
