{
  "queue_synchronous": false,
  "audit_entries": 1000,
  "line_max": 1048576,
  "blob_max": 10485760,
  "overflow_bytes": 131072,
  "chunk_bytes": 1048576,
  "srv_buf_size": 1048576,
  "media_db_bytes": 10485760,
  "turn_compact_turns": 64,
  "provider": {
    "scripted": true,
    "timeout_seconds": 120,
    "variable": "XSJS_PROVIDER_KEY"
  },
  "powershell": {
    "windows_port": 5768,
    "windows_address": "127.0.0.1",
    "linux_port": 5769,
    "bind_address": "127.0.0.1",
    "bootstrap_script": "bootstrap.py",
    "engine_page": "hyperposition-engine.html",
    "ttyd_build": "build/ttyd",
    "ttyd_archive": "third_party/ttyd/ttyd-1.7.7.tar.gz",
    "ttyd_patches": "third_party/ttyd/patches",
    "terminal_type": "dumb",
    "linux_folder": ".cache/xsjs",
    "container": "hype",
    "container_user": "t",
    "container_root": "/home/t/xstation.js",
    "container_interface": "0.0.0.0",
    "sync_script": "wslc_sync.sh",
    "ttyd_log_file": "ttyd.log",
    "poll_tries": 30,
    "poll_milliseconds": 500,
    "output_width": 200,
    "root_files": ["settings.json", "provider.json"],
    "root_records": ["_audit.txt", "tap"],
    "runtime_modules": [
      "internationalization",
      "jslb",
      "audit",
      "verbose",
      "switches",
      "settings",
      "substrate",
      "dispatch",
      "mcp",
      "mcp_stdio",
      "engine_kv",
      "engine_doc",
      "engine_db",
      "engine_turn",
      "engine_sql",
      "engine_audit",
      "engine_tap",
      "engine_mcp",
      "engine_system",
      "main_loop",
      "bootstrap"
    ]
  }
}
