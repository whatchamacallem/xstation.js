    "formatter": ["prettier", "--write", "--no-config", "--print-width", "79"],
    "linter": [],
    "system": "linux"
  },
  ".ps1": {
    "checker": [],
    "comments": "powershell",
    "encoding": "utf-8-sig",
    "formatter": [],
    "linter": [],
    "system": "windows"
  },
  ".psd1": {
    "checker": [],
    "comments": "powershell",
    "encoding": "utf-8-sig",
    "formatter": [],
    "linter": [],
    "system": "windows"
  },
  ".py": {
    "checker": ["ruff", "format", "--check", "--config", "python/pyproject.toml", "--cache-dir", "build/ruff_cache"],
