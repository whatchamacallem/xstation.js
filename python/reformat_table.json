    "formatter": ["prettier", "--write", "--no-config", "--print-width", "79"],
    "linter": [],
    "system": "linux"
  },
  ".js": {
    "checker": ["prettier", "--check", "--no-config", "--print-width", "79"],
    "comments": "javascript",
